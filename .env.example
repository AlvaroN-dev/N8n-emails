# ==============================================================================
# ticket-triage-n8n - variables de entorno
#
# NO edites este archivo para poner secretos reales. Genera tu .env con:
#     .\scripts\setup.ps1
# Reemplaza cada valor CHANGE_ME por un secreto aleatorio. El .env esta en
# .gitignore y NUNCA debe subirse a Git.
# ==============================================================================

# --- General -------------------------------------------------------------------
# Zona horaria de n8n (nombres IANA). Ejemplos: UTC, America/Bogota, Europe/Madrid
GENERIC_TIMEZONE=UTC

# --- Puertos publicados en el host ---------------------------------------------
# Siempre se enlazan a 127.0.0.1: solo accesibles desde tu propio equipo.
N8N_HOST_PORT=5678
MAILPIT_HOST_PORT=8025
API_HOST_PORT=8000

# --- PostgreSQL (base de datos de la API Django) --------------------------------
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=CHANGE_ME

# --- API Django ----------------------------------------------------------------
# Clave de firma interna de Django. Obligatoria: la API no arranca sin ella.
DJANGO_SECRET_KEY=CHANGE_ME
# Clave que n8n envia en la cabecera X-API-Key. Obligatoria: la API no arranca sin ella.
DJANGO_API_KEY=CHANGE_ME
# Hosts que la API acepta (incluye `api`: el nombre con el que n8n la llama dentro de Docker).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Mantener en false. DEBUG=true expone informacion interna y solo es valido en pruebas locales.
DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO
# Herramientas de QA: inyeccion de fallos (external_id con prefijo QA-500- / QA-SLOW-) y LLM simulado.
# SOLO para desarrollo y pruebas locales. En cualquier otro entorno debe ser false.
QA_TOOLS_ENABLED=true

# --- Credenciales de n8n (las crea scripts/import-n8n.ps1 a partir de estos valores) ----
# Los workflows NO leen variables de entorno (n8n 2.x lo bloquea): todo secreto vive en
# credenciales cifradas de n8n.
# Token que deben enviar los clientes en la cabecera X-Webhook-Token al webhook PUBLICO de entrada.
INTAKE_WEBHOOK_TOKEN=CHANGE_ME
# Token del webhook INTERNO de triage (WF1 -> WF2 y reprocesado manual). Distinto del anterior.
INTERNAL_WEBHOOK_TOKEN=CHANGE_ME
# Proveedor de IA que usa WF2: `mock` (LLM simulado local, sin cuentas ni costes; requiere QA_TOOLS_ENABLED=true)
# o `gemini` (IA real; requiere GEMINI_API_KEY). Tras cambiarlo, ejecuta .\scripts\import-n8n.ps1.
LLM_PROVIDER=mock
# OPCIONAL. API key de Google AI Studio para probar IA real con Gemini. Vacia = solo IA simulada.
# ATENCION: la capa gratuita de Gemini usa el contenido enviado para mejorar productos de Google:
# usa SOLO datos sinteticos. Esta clave nunca debe subirse a Git.
GEMINI_API_KEY=

# --- n8n -----------------------------------------------------------------------
# Clave que cifra las credenciales guardadas dentro de n8n. Si la pierdes o la
# cambias, las credenciales ya guardadas dejan de poder descifrarse.
# Haz una copia de seguridad de esta clave fuera del repositorio.
N8N_ENCRYPTION_KEY=CHANGE_ME
